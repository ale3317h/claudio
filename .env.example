# CLAUDIO Environment Variables
# Copia este archivo a .env y completa los valores

# CLAUDIO - Groq (gratis, sin tarjeta): https://console.groq.com/keys
GROQ_API_KEY=gsk_tu_clave_aqui
# Rotación multi-cuenta (opcional, coma-separadas):
# GROQ_API_KEYS=gsk_aaa,gsk_bbb

# CLAUDIO - Gemini (gratis, cupo generoso): https://aistudio.google.com/apikey
# GOOGLE_API_KEY=tu_clave_aqui

# CLAUDIO - OpenRouter (modelos :free): https://openrouter.ai/keys
# OPENROUTER_API_KEY=tu_clave_aqui

# CLAUDIO - DreamPrompting (500K/día pooled): panel de tu cuenta
# DREAMPROMPTING_API_KEY=tu_clave_aqui

# CLAUDIO - Meta Model API / Muse Spark (1M contexto, pay-as-you-go): https://dev.meta.ai/api-keys
# MODEL_API_KEY=tu_clave_aqui

# CLAUDIO - GitHub Models (gratis con tu cuenta): Settings > Developer settings > Personal access tokens (permiso Models)
# GITHUB_PAT=tu_clave_aqui

# Ollama (local LLM)
OLLAMA_HOST=http://localhost:11434

# Discord (Server Settings > Integrations > Webhooks > New webhook > Copy URL)
# DISCORD_WEBHOOK=https://discord.com/api/webhooks/...
# Canales extra: DISCORD_WEBHOOK_AVISOS=https://...
# Self-bot (opcional, riesgo de baneo): token de usuario + ID del canal
# DISCORD_USER_TOKEN=...
# DISCORD_CHANNEL_ID=...

# APIs externas (opcional - solo si usas cloud fallback)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# Búsqueda web (Tavily, gratis 1000/mes): https://tavily.com
# TAVILY_API_KEY=tvly-...
# Backup con coma-separadas (si una muere/cuota, sigue la otra):
# TAVILY_API_KEYS=tvly-aaa,tvly-bbb
# Búsqueda web (SearXNG self-hosted)
SEARXNG_URL=http://localhost:8080

# Calendar (CalDAV / Google)
CALDAV_URL=
CALDAV_USERNAME=
CALDAV_PASSWORD=
GOOGLE_CALENDAR_CREDENTIALS_PATH=

# YouTube Music permanente (OAuth, no vence): corre scripts/setup_ytmusic_oauth.py una vez.
# Requiere client_id/secret de Google Cloud (TVs and Limited Input devices).
# YTMUSIC_CLIENT_ID=tu_client_id_aqui
# YTMUSIC_CLIENT_SECRET=tu_client_secret_aqui
# Legacy (se vence): YTMUSIC_HEADERS=data/ytmusic_headers.json

# Voz (opcional)
PORCUPINE_ACCESS_KEY=
PIPER_MODEL_PATH=

# Seguridad
CLAUDIO_SECRET_KEY=tu_clave_secreta_aqui